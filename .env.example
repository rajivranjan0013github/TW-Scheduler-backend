NODE_ENV=production
PORT=5001
BACKEND_URL=https://thousandpost.com
ALLOWED_ORIGINS=https://thousandpost.com,https://www.thousandpost.com
DEMO_MODE=false
ENABLE_LIVE_PUBLISHING=true
ENABLE_BACKGROUND_SYNC=true

MONGODB_URI=
JWT_SECRET=
SOCIAL_TOKEN_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://thousandpost.com/auth/youtube/callback

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://thousandpost.com/auth/facebook/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://thousandpost.com/auth/instagram/callback
META_GRAPH_API_VERSION=v26.0

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tw-creator-suite
R2_PUBLIC_URL=https://media.thousandpost.com

REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

GEMINI_API_KEY=

# One-time use by `npm run reviewer:provision`; remove from the deployed
# environment after provisioning and store the credentials in a password manager.
REVIEWER_EMAIL=
REVIEWER_PASSWORD=
REVIEWER_NAME=Platform App Reviewer
